import ee
import geemap
from dotenv import load_dotenv
import os

# Load environment variables
load_dotenv()
PROJECT_ID = os.getenv("earth_id")  # optional if already authenticated
print("PROJECT_ID =", PROJECT_ID)

# Authenticate & initialize Earth Engine
try:
    ee.Initialize(project=PROJECT_ID)
except Exception:
    ee.Authenticate()
    ee.Initialize(project=PROJECT_ID)

# Load Copernicus land cover dataset
dataset = ee.Image(
    "COPERNICUS/Landcover/100m/Proba-V-C3/Global/2019"
).select("discrete_classification")

# Visualization parameters (important for readability)
vis_params = {
    "min": 10,
    "max": 100,
    "palette": [
        "006400",  # Forest
        "ffbb22",  # Shrubland
        "ffff4c",  # Grassland
        "f096ff",  # Cropland
        "fa0000",  # Urban
        "b4b4b4",  # Bare
        "f0f0f0",  # Snow/Ice
        "0064c8",  # Water
    ],
}

# Create interactive map (Jupyter-friendly)
m = geemap.Map(center=[26.4, -88.6], zoom=3)
m.add_layer(dataset, vis_params, "Land Cover 2019")


m
